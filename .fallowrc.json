{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
    "framework": [
        {
            "name": "wire-contract-node-tests",
            "detection": {
                "type": "fileExists",
                "pattern": "scripts/wire-contract-checks.mjs"
            },
            "entryPoints": ["scripts/wire-contract-checks.mjs"],
            "entryPointRole": "test"
        }
    ],
    "duplicates": {
        // Hide pair-only clones; focus on widespread copy-paste
        // worth refactoring. Lower to 2 to report every duplicate pair.
        "minOccurrences": 3
    },
    "rules": {
        "unused-dependencies": "warn"
    },
    // Optional peer dependencies used only for dynamic TS config loading
    // (eslint.config.ts / vite.config.ts), never imported from source —
    // static analysis can't see this usage.
    "ignoreDependencies": ["jiti"]
}
