{
    "name": "jobmatch",
    "version": "0.5.12",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "test:lint-config": "node --test scripts/__tests__/eslint-config.mjs",
        "build": "vite build",
        "type-check": "npm run check:wire-contract && vue-tsc --build",
        "lint": "eslint . --fix",
        "format": "prettier --write --experimental-cli src/",
        "check:wire-contract": "node scripts/wire-contract.mjs --check",
        "check:wire-contract:upstream": "node scripts/wire-contract.mjs --check-upstream",
        "sync:wire-contract": "node scripts/wire-contract.mjs --update",
        "test:wire-contract": "node --test scripts/wire-contract-checks.mjs"
    },
    "dependencies": {
        "vue": "^3.5.43",
        "vue-router": "^5.0.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^24.12.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vitest/eslint-plugin": "^1.6.16",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.10.1",
        "eslint-plugin-vue": "~10.8.0",
        "fallow": "^2.96.0",
        "jiti": "^2.7.0",
        "jsdom": "^29.0.2",
        "prettier": "3.8.3",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.60.1",
        "tinyglobby": "^0.2.15",
        "vite": "^8.0.8",
        "vite-plugin-vue-devtools": "^8.1.1",
        "vitest": "^4.1.4",
        "vue-tsc": "^3.2.6",
        "vue-eslint-parser": "^10.4.0"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
